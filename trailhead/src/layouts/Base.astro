---
interface Props {
  title?: string;
}
const { title = 'Trailhead' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 min-h-screen">
    <header class="border-b px-6 py-4 flex items-center justify-between">
      <h1 class="text-xl font-semibold">🌲 Trailhead</h1>
      <nav class="flex gap-4 text-sm">
        <a href="/" class="text-gray-600 hover:text-gray-900">Dashboard</a>
        <a href="/gantt" class="text-gray-600 hover:text-gray-900">Gantt</a>
      </nav>
    </header>
    <main class="px-6 py-6">
      <slot />
    </main>
  </body>
</html>