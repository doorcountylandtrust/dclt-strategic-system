---
interface Props {
  title?: string;
}
const { title = 'Trailhead' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-gray-900 min-h-screen">
    <header class="border-b px-6 py-4">
      <h1 class="text-xl font-semibold">🌲 Trailhead</h1>
    </header>
    <main class="px-6 py-6">
      <slot />
    </main>
  </body>
</html>