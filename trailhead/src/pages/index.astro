---
import Base from '../layouts/Base.astro';
import { loadAllDocs, getByStatus, getOverdue, getStale } from '../lib/frontmatter';
import { buildHierarchy, countDescendants } from '../lib/hierarchy';
import FilterableProjectList from '../components/FilterableProjectList.tsx';
import ProjectTree from '../components/ProjectTree.tsx';

const docs = loadAllDocs();
const active = getByStatus(docs, 'active');
const overdue = getOverdue(docs);
const stale = getStale(docs);
const withFrontmatter = docs.filter((d) => d.hasFrontmatter);

// Build hierarchy to get child counts
const trees = buildHierarchy(docs);
const childCounts = new Map<string, number>();
for (const tree of trees) {
  childCounts.set(tree.doc.slug, countDescendants(tree));
}

// Serialize for the React island (no functions, no circular refs)
const docSummaries = docs.map((d) => ({
  slug: d.slug,
  title: d.title,
  status: d.status,
  priority: d.priority,
  type: d.type,
  owner: d.owner,
  created: d.created,
  due: d.due,
  updated: d.updated,
  hasFrontmatter: d.hasFrontmatter,
  childCount: childCounts.get(d.slug) ?? 0,
}));

// Serialize tree for ProjectTree React island
function serializeTree(node: any): any {
  return {
    slug: node.doc.slug,
    title: node.doc.title,
    status: node.doc.status,
    priority: node.doc.priority,
    type: node.doc.type,
    owner: node.doc.owner,
    due: node.doc.due,
    updated: node.doc.updated,
    children: node.children.map(serializeTree),
  };
}
const serializedTrees = trees.map(serializeTree);
---
<Base title="Trailhead — Dashboard">
  <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; margin-bottom: 2rem;">
    <div class="border rounded p-4 text-center">
      <div class="text-3xl font-bold">{docs.length}</div>
      <div class="text-sm text-gray-500">Total files</div>
    </div>
    <div class="border rounded p-4 text-center">
      <div class="text-3xl font-bold">{withFrontmatter.length}</div>
      <div class="text-sm text-gray-500">With frontmatter</div>
    </div>
    <div class="border rounded p-4 text-center">
      <div class="text-3xl font-bold text-blue-600">{active.length}</div>
      <div class="text-sm text-gray-500">Active</div>
    </div>
    <div class="border rounded p-4 text-center">
      <div class="text-3xl font-bold text-red-600">{overdue.length}</div>
      <div class="text-sm text-gray-500">Overdue</div>
    </div>
    <div class="border rounded p-4 text-center">
      <div class="text-3xl font-bold text-yellow-600">{stale.length}</div>
      <div class="text-sm text-gray-500">Stale (30+ days)</div>
    </div>
  </div>

  <h2 class="text-lg font-semibold mb-3">All Projects</h2>
  <FilterableProjectList docs={docSummaries} client:load />

  <h2 class="text-lg font-semibold mb-3 mt-10">Project Tree</h2>
  <ProjectTree trees={serializedTrees} client:load />
</Base>