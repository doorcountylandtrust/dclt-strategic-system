---
import Base from '../layouts/Base.astro';
import { loadAllDocs, getByStatus, getOverdue, getStale } from '../lib/frontmatter';
import { buildHierarchy, groupByTopDir, countDescendants } from '../lib/hierarchy';

const docs = loadAllDocs();
const active = getByStatus(docs, 'active');
const overdue = getOverdue(docs);
const stale = getStale(docs);
const withFrontmatter = docs.filter((d) => d.hasFrontmatter);

const trees = buildHierarchy(docs);
const groups = groupByTopDir(trees);
---
<Base title="Trailhead — Dashboard">
  <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; margin-bottom: 2rem;">
    <div class="border rounded p-4 text-center">
      <div class="text-3xl font-bold">{docs.length}</div>
      <div class="text-sm text-gray-500">Total files</div>
    </div>
    <div class="border rounded p-4 text-center">
      <div class="text-3xl font-bold">{withFrontmatter.length}</div>
      <div class="text-sm text-gray-500">With frontmatter</div>
    </div>
    <div class="border rounded p-4 text-center">
      <div class="text-3xl font-bold text-blue-600">{active.length}</div>
      <div class="text-sm text-gray-500">Active</div>
    </div>
    <div class="border rounded p-4 text-center">
      <div class="text-3xl font-bold text-red-600">{overdue.length}</div>
      <div class="text-sm text-gray-500">Overdue</div>
    </div>
    <div class="border rounded p-4 text-center">
      <div class="text-3xl font-bold text-yellow-600">{stale.length}</div>
      <div class="text-sm text-gray-500">Stale (30+ days)</div>
    </div>
  </div>

  <h2 class="text-lg font-semibold mb-3">Active Projects</h2>
  <table class="w-full text-sm border-collapse">
    <thead>
      <tr class="border-b text-left">
        <th class="py-2 pr-4">Title</th>
        <th class="py-2 pr-4">Priority</th>
        <th class="py-2 pr-4">Owner</th>
        <th class="py-2 pr-4">Due</th>
        <th class="py-2 pr-4">Updated</th>
      </tr>
    </thead>
    <tbody>
      {active.map((doc) => (
        <tr class="border-b">
          <td class="py-2 pr-4"><a href={`/project/${doc.slug}`} class="text-blue-600 hover:underline">{doc.title}</a></td>
          <td class="py-2 pr-4">{doc.priority ?? '—'}</td>
          <td class="py-2 pr-4">{doc.owner ?? '—'}</td>
          <td class="py-2 pr-4">{doc.due ?? '—'}</td>
          <td class="py-2 pr-4">{doc.updated ?? '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2 class="text-lg font-semibold mb-3 mt-8">Project Tree</h2>
  {groups.map((group) => (
    <div class="mb-6">
      <h3 class="text-md font-semibold text-gray-600 mb-2">
        {group.groupName.replace(/^\d+_/, '').replace(/_/g, ' ')}
      </h3>
      <ul class="ml-4 space-y-1 text-sm">
        {group.trees.map((node) => (
          <li>
            <div class="flex items-center gap-2">
              <span class={`inline-block w-2 h-2 rounded-full ${
                node.doc.status === 'active' ? 'bg-blue-500' :
                node.doc.status === 'completed' ? 'bg-green-500' :
                node.doc.status === 'on-hold' ? 'bg-gray-400' :
                node.doc.status === 'planning' ? 'bg-yellow-400' :
                'bg-gray-200'
              }`} />
              <span><a href={`/project/${node.doc.slug}`} class="hover:underline">{node.doc.title}</a></span>
              {node.children.length > 0 && (
                <span class="text-gray-400 text-xs">({countDescendants(node)} items)</span>
              )}
            </div>
            {node.children.length > 0 && (
              <ul class="ml-6 mt-1 space-y-1">
                {node.children.map((child) => (
                  <li class="flex items-center gap-2">
                    <span class={`inline-block w-1.5 h-1.5 rounded-full ${
                      child.doc.status === 'active' ? 'bg-blue-500' :
                      child.doc.status === 'completed' ? 'bg-green-500' :
                      child.doc.status === 'on-hold' ? 'bg-gray-400' :
                      child.doc.status === 'planning' ? 'bg-yellow-400' :
                      'bg-gray-200'
                    }`} />
                    <span class="text-gray-700"><a href={`/project/${child.doc.slug}`} class="hover:underline">{child.doc.title}</a></span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>
  ))}
</Base>