			title="Ephraim Preserve at Anderson Pond" 
						data-caption="Ephraim Preserve at Anderson Pond"
						data-description="Photo by Dan Eggert" 
			itemprop="contentUrl">
			<img src="https://www.doorcountylandtrust.org/wp-content/uploads/2014/11/Ephraim_preserve_Dan_Eggert_woods-300x200.png" alt="Ephraim Preserve at Anderson Pond" data-no-lazy="1" itemprop="thumbnail" width="300" height="200" />
