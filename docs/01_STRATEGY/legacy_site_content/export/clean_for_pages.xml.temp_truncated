		<title><![CDATA[Detroit Harbor Nature Preserve]]></title>
		<link>https://www.doorcountylandtrust.org/detroit-harbor-nature-preserve/</link>
		<pubDate>Wed, 12 Nov 2014 03:30:12 +0000</pubDate>
		<dc:creator><![CDATA[dcltadmin]]></dc:creator>
		<guid isPermaLink="false">http://www.doorcountylandtrust.org/?page_id=2683</guid>
